---
import Layout from '../layouts/Layout.astro';
import { site } from '../config';

import { Image } from "astro:assets";
import { getCollectionSorted } from "../lib/utils";

const projects = await getCollectionSorted("projects");

---

<Layout title={`${site.name} | ${site.tagline}`}>
	<div class="description">
		<h2>{ site.description }</h2>
		<a href="/about">About →</a>
	</div>
	<div class="projects">
		{ projects.map((project, idx) => (
			<div class={`project ${project}`}>
				<a href={ `/${project.collection}/${project.id}`}>
					<figure style={{ backgroundColor: project.data.color }}>
						<Image src={project.data.cover} alt={project.data.coverAlt} />
					</figure>
					<h2>{ project.data.title }</h2>
				</a>
			</div>
		))}
	</div>
</Layout>
