---
import { navLinks } from "../config";
const { pathname } = Astro.url
---

<header>
  <nav id="nav" class="container">
    <h1 class="logo"><a href="/">Derek Olson</a></h1>
    <ul>
      { navLinks.map((item) => (
        <li class="nav-item">
          <a href={ item.url } class={pathname === item.url ? "active" : ""} aria-current={pathname === item.url ? "page" : undefined}>
            { item.title }
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
