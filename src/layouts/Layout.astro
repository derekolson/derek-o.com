---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Head from '../components/Head.astro'
import { site } from '../config';

import "../styles/style.scss";

interface Props {
	title: string;
	description: string;
	heroImage?: ImageMetadata;
	frontmatter?: Record<string, any>;
}

const { title, description, heroImage } = Astro.props.frontmatter || Astro.props;
const siteTitle = Astro.url.pathname === '/' ? `${site.name} | ${title}` : `${title} | ${site.name}`
---

<!doctype html>
<html lang="en">
	<Head title={siteTitle} description={description} heroImage={heroImage} />
	<body>
		<Navigation />
		<main>
			<div class="container">
				<slot />
			</div>
		</main>
		<Footer />
	</body>
</html>
