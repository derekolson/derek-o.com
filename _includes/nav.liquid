{% assign nav_pages = collections.all | eleventyNavigation %}

<header>
  <nav id="nav" class="container">
    <h1 class="logo"><a href="/">Derek Olson</a></h1>
    <ul>
      {%- for item in nav_pages %}
        <li class="nav-item">
          <a href="{{ item.url }}"{% if item.url == page.url %} class="active" aria-current="page"{% endif %}>{{ item.title }}</a>
        </li>
      {%- endfor %}
    </ul>
  </nav>
</header>
