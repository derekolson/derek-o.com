<nav class="pagination">
    {% if pagination.href.next %}
        <a class="next" href="{{pagination.href.next}}">&laquo; {{pagination.href.next}}</a>
    {% endif %}
    {% if pagination.href.previous %}
        <a class="prev" href="{{pagination.href.previous}}">{{pagination.href.previous}} &raquo;</a>
    {% endif %}
</nav>
