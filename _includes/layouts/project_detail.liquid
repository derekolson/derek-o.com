{% assign previousPage = collections.projects | getPreviousCollectionItem %}
{% assign nextPage = collections.projects | getNextCollectionItem %}
<!DOCTYPE html>
<html lang="en">
{% include "head.html" %}
<body>
  {% include "nav.liquid" %}
  <main>
    <div class="container">
      <div class="description">
        <h2>{{ title }}</h2>
        <h3>{{ description }}</h3>
        <p class="tags"><em>{{ tags | join: ", "}}</em></p>
      </div>
      {{ content }}
      <nav class="pagination">
        {% if nextPage %}
          <a class="next" href="{{nextPage.url}}">&laquo; {{ nextPage.data.title }}</a>
        {% endif %}
        {% if previousPage %}
          <a class="prev" href="{{previousPage.url}}">{{ previousPage.data.title }} &raquo;</a>
        {% endif %}
      </nav>
    </div>
  </main>
{% include "footer.html" %}
</body>
</html>
